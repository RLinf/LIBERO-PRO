# Data shipped inside the wheel/sdist. The large mesh/texture assets under
# libero/libero/assets are intentionally NOT included (PyPI 100MB limit) and are
# downloaded after install with `libero-download-assets`.
recursive-include libero/libero/bddl_files *
recursive-include libero/libero/init_files *

# Never package the assets tree.
prune libero/libero/assets

global-exclude *.py[cod]
global-exclude __pycache__
