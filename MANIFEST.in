# Ship the benchmark data alongside the package so a non-editable
# `pip install git+...` (as used by RPent's optional-dependencies) bundles
# the bddl task definitions, pruned init states, and simulation assets into
# the built wheel. Without this, include_package_data has nothing to pick up
# and the installed package renders empty benchmarks.
recursive-include liberopro/liberopro/bddl_files *
recursive-include liberopro/liberopro/init_files *
recursive-include liberopro/liberopro/assets *
