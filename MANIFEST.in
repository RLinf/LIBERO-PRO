# Data shipped inside the wheel/sdist. The large mesh/texture assets under
# liberopro/liberopro/assets are intentionally NOT included (PyPI 100MB limit)
# and are downloaded after install with `liberopro-download-assets`.
recursive-include liberopro/liberopro/bddl_files *
recursive-include liberopro/liberopro/init_files *

# Never package the assets tree.
prune liberopro/liberopro/assets

global-exclude *.py[cod]
global-exclude __pycache__
